
## 1. Recursion

```python
class Solution:
    def dfs(self, u, p, adj, s, ans):
        best1 = best2 = 1

        for v in adj[u]:
            if v == p or s[v] != s[u]:
                continue

            x = self.dfs(v, u, adj, s, ans) + 1

            if x > best1:
                best1, best2 = x, best1
            elif x > best2:
                best2 = x

        ans[0] = max(ans[0], best1 + best2 - 1)
        return best1

    def longestPath(self, s, edges):
        n = len(s)
        adj = [[] for _ in range(n)]

        for u, v in edges:
            u -= 1
            v -= 1
            adj[u].append(v)
            adj[v].append(u)

        ans = [1]

        self.dfs(0, -1, adj, s, ans)

        down = [1] * n
        parent = [-1] * n
        order = [0]

        for u in order:
            for v in adj[u]:
                if v != parent[u]:
                    parent[v] = u
                    order.append(v)

        for u in order[::-1]:
            for v in adj[u]:
                if parent[v] == u and s[v] == s[u]:
                    down[u] = max(down[u], down[v] + 1)

        up = [1] * n

        for u in order:
            first = second = 1

            for v in adj[u]:
                if v == parent[u] or s[v] != s[u]:
                    continue

                x = down[v] + 1

                if x > first:
                    first, second = x, first
                elif x > second:
                    second = x

            if parent[u] != -1 and s[parent[u]] == s[u]:
                x = up[u]
                first = max(first, x)

            for v in adj[u]:
                if parent[v] != u or s[v] != s[u]:
                    continue

                x = down[v] + 1
                use = second if x == first else first
                up[v] = use + 1

        for u, v in edges:
            u -= 1
            v -= 1

            if s[u] == s[v]:
                continue

            if s[u] == 'R':
                r = max(up[u], down[u])
                b = max(up[v], down[v])
                ans[0] = max(ans[0], r + b)

            else:
                r = max(up[v], down[v])
                b = max(up[u], down[u])
                ans[0] = max(ans[0], r + b)

        return ans[0]
```

**TC:** `O(n)`
**SC:** `O(n)`

