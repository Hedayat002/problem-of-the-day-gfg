## 3. Tabulation (Bottom-Up)

```python
class Solution:
    def dfs(self, u, p, adj, parent, order):
        parent[u] = p

        for v in adj[u]:
            if v != p:
                self.dfs(v, u, adj, parent, order)

        order.append(u)

    def longestPath(self, s, edges):
        n = len(s)
        adj = [[] for _ in range(n)]

        for u, v in edges:
            u -= 1
            v -= 1
            adj[u].append(v)
            adj[v].append(u)

        parent = [-1] * n
        order = []

        self.dfs(0, -1, adj, parent, order)

        down = [1] * n

        for u in order:
            for v in adj[u]:
                if parent[v] == u and s[u] == s[v]:
                    down[u] = max(down[u], down[v] + 1)

        up = [1] * n
        ans = 1

        for u in order[::-1]:
            first = second = 1
            first_id = -1

            if parent[u] != -1 and s[parent[u]] == s[u]:
                first = up[u]
                first_id = parent[u]

            for v in adj[u]:
                if parent[v] == u and s[v] == s[u]:
                    x = down[v] + 1

                    if x > first:
                        second = first
                        first = x
                        first_id = v
                    elif x > second:
                        second = x

            ans = max(ans, first + second - 1)

            for v in adj[u]:
                if parent[v] == u and s[v] == s[u]:
                    x = down[v] + 1

                    if first_id == v:
                        use = second
                    else:
                        use = first

                    up[v] = use + 1

        for u, v in edges:
            u -= 1
            v -= 1

            if s[u] != s[v]:
                ans = max(
                    ans,
                    max(down[u], up[u]) + max(down[v], up[v])
                )

        return ans
```

**TC:** `O(n)`
**SC:** `O(n)`

