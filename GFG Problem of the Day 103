## 2. Memoization (Top-Down)

```python
class Solution:
    def dfs(self, u, p, adj, s, dp):
        if dp[u] != -1:
            return dp[u]

        best = 1

        for v in adj[u]:
            if v == p or s[v] != s[u]:
                continue

            best = max(best, self.dfs(v, u, adj, s, dp) + 1)

        dp[u] = best
        return best

    def longestPath(self, s, edges):
        n = len(s)
        adj = [[] for _ in range(n)]

        for u, v in edges:
            u -= 1
            v -= 1
            adj[u].append(v)
            adj[v].append(u)

        parent = [-1] * n
        order = [0]

        for u in order:
            for v in adj[u]:
                if v != parent[u]:
                    parent[v] = u
                    order.append(v)

        dp = [-1] * n

        for u in order[::-1]:
            self.dfs(u, parent[u], adj, s, dp)

        up = [1] * n
        ans = max(dp)

        for u in order:
            best1 = best2 = 1
            id1 = -1

            if parent[u] != -1 and s[parent[u]] == s[u]:
                best1 = up[u]
                id1 = parent[u]

            for v in adj[u]:
                if parent[v] != u or s[v] != s[u]:
                    continue

                x = dp[v] + 1

                if x > best1:
                    best2 = best1
                    best1 = x
                    id1 = v
                elif x > best2:
                    best2 = x

            ans = max(ans, best1 + best2 - 1)

            for v in adj[u]:
                if parent[v] != u or s[v] != s[u]:
                    continue

                x = dp[v] + 1

                if id1 == v:
                    use = best2
                else:
                    use = best1

                up[v] = use + 1

        for u, v in edges:
            u -= 1
            v -= 1

            if s[u] == s[v]:
                continue

            if s[u] == 'R':
                ans = max(ans, max(dp[u], up[u]) + max(dp[v], up[v]))
            else:
                ans = max(ans, max(dp[v], up[v]) + max(dp[u], up[u]))

        return ans
```

**TC:** `O(n)`
**SC:** `O(n)`

