## Optimal — Z-Algorithm + Stack

```python
class Solution:
    def compress(self, s):
        n = len(s)

        z = [0] * n
        left = right = 0

        for i in range(1, n):
            if i <= right:
                z[i] = min(right - i + 1, z[i - left])

            while i + z[i] < n and s[z[i]] == s[i + z[i]]:
                z[i] += 1

            if i + z[i] - 1 > right:
                left = i
                right = i + z[i] - 1

        stack = []
        i = n - 1

        while i > 0:
            length = i + 1

            if length % 2 == 0:
                half = length // 2

                if z[half] >= half:
                    stack.append('*')
                    i = half - 1
                    continue

            stack.append(s[i])
            i -= 1

        ans = [s[0]]

        while stack:
            ans.append(stack.pop())

        return "".join(ans)
```

**TC:** O(n)
**SC:** O(n)

