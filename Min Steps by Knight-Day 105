Since every knight move has the same cost of 1, BFS finds the shortest path without exploring every possible path.


from collections import deque

class Solution:
    def minStepToReachTarget(
        self,
        knightPos: list[int],
        targetPos: list[int],
        n: int
    ) -> int:

        x = knightPos[0] - 1
        y = knightPos[1] - 1

        tx = targetPos[0] - 1
        ty = targetPos[1] - 1

        visited = [[False] * n for _ in range(n)]
        visited[x][y] = True

        dx = [2, 2, -2, -2, 1, 1, -1, -1]
        dy = [1, -1, 1, -1, 2, -2, 2, -2]

        q = deque([(x, y, 0)])

        while q:
            x, y, steps = q.popleft()

            if x == tx and y == ty:
                return steps

            for i in range(8):
                nx = x + dx[i]
                ny = y + dy[i]

                if (0 <= nx < n and
                    0 <= ny < n and
                    not visited[nx][ny]):

                    visited[nx][ny] = True
                    q.append((nx, ny, steps + 1))

        return -1
Efficient solution

BFS complexity
Time: O(n2)
Space: O(n2)

BFS visits each board cell at most once and processes at most eight moves per cell.
