class Solution:
    def solve(self,x, y, tx, ty, n, visited):
        
        # If target is reached
        if x == tx and y == ty:
            return 0

        ans = float('inf')
        
        # All 8 possible Knight moves
        dx = [2, 2, -2, -2, 1, 1, -1, -1]
        dy = [1, -1, 1, -1, 2, -2, 2, -2]

        for i in range(8):
            nx = x + dx[i]
            ny = y + dy[i]
            # Check boundaries and visited cells
            if (0 <= nx < n and
                0 <= ny < n and
                not visited[nx][ny]):

                # Mark visited
                visited[nx][ny] = True

                # Recursive call
                steps = self.solve(
                    nx, ny, tx, ty, n, visited
                )

                # Update minimum steps
                if steps != float('inf'):
                    ans = min(ans, 1 + steps)

                # Backtracking
                visited[nx][ny] = False

        return ans
            
        
    
        
