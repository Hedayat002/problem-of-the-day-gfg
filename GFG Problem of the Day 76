    def minCost(self, n, i, d, c):
        if n == 1:
            return i

        dp = [0] * (n + 1)
        dp[1] = i

        for x in range(2, n + 1):
            dp[x] = dp[x - 1] + i

            if x % 2 == 0:
                dp[x] = min(dp[x], dp[x // 2] + c)
            else:
                dp[x] = min(dp[x], dp[x // 2] + c + i)
                dp[x] = min(dp[x], dp[(x + 1) // 2] + c + d)

        return dp[n]
```

**TC:** O(n)
