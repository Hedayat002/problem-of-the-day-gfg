1. Recursion
class Solution:
    def solve(self, i, prev, mat):
        n = len(mat)

        if i == n:
            return 0

        ans = float('inf')

        for choice in range(3):
            if choice != prev:
                ans = min(
                    ans,
                    mat[i][choice] + self.solve(i + 1, choice, mat)
                )

        return ans

    def minCost(self, mat):
        return min(
            mat[0][0] + self.solve(1, 0, mat),
            mat[0][1] + self.solve(1, 1, mat),
            mat[0][2] + self.solve(1, 2, mat)
        )

TC: O(2ⁿ)
SC: O(n)

2. Memoization (Top-Down)
class Solution:
    def solve(self, i, prev, mat,dp):
        n = len(mat)
    
        # All rows processed
        if i == n:
            return 0
    
        ans = float('inf')
        if dp[i][prev] != -1:
            dp[i][prev]
            
     
        # Try all 3 columns
        for choice in range(3):
    
            # Cannot choose same column as previous row
            if choice != prev:
                ans = min(
                    ans,
                    mat[i][choice] + self.solve(i + 1, choice, mat,dp)
                )
        dp[i][prev] = ans
    
        return dp[i][prev]

    def minCost(self, mat):
        """code here"""
        n = len(mat)
        dp = [[-1] * 3 for _ in range(n)]

        return min(
            mat[0][0] + self.solve(1, 0, mat,dp),
            mat[0][1] + self.solve(1, 1, mat,dp),
            mat[0][2] + self.solve(1, 2, mat,dp)
        )
TC: O(n)
SC: O(n)

3. Tabulation (Bottom-Up)
class Solution:

    def minCost(self, mat):
        """code here"""
        n = len(mat)

        dp = [[0] * 3 for _ in range(n)]

        for j in range(3):
            dp[0][j] = mat[0][j]

        for i in range(1, n):
            for j in range(3):
                ans = float('inf')

                for k in range(3):
                    if k != j:
                        ans = min(ans, dp[i - 1][k])

                dp[i][j] = mat[i][j] + ans

        return min(dp[n - 1])
TC: O(n)
SC: O(n)

4. Space Optimization
class Solution:

    def minCost(self, mat):
        """code here"""
        n = len(mat)

        prev = mat[0][:]

        for i in range(1, n):
            curr = [0] * 3
            for j in range(3):
                curr[j] = mat[i][j] + min(
                            prev[k]
                            for k in range(3)
                            if k != j
                        )

            prev = curr

        return min(prev)
TC: O(n)
SC: O(1)
