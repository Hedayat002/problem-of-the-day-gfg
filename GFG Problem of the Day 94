class Solution:

    def inOrder(self, node):
        if not node:
            return

        self.inOrder(node.left)

        if self.prev is not None:
            self.ans = min(
                self.ans,
                node.data - self.prev
            )

        self.prev = node.data

        self.inOrder(node.right)

    def absDiff(self, root):
        self.prev = None
        self.ans = float('inf')

        self.inOrder(root)

        return self.ans

Time  = O(N)
Space = O(H)
