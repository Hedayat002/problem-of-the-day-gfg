1. Recursion
class Solution:
    def maxHeight(self, height, width, length):
        boxes = []

        for i in range(len(height)):
            self.addBox(boxes, width[i], length[i], height[i])
            self.addBox(boxes, height[i], length[i], width[i])
            self.addBox(boxes, height[i], width[i], length[i])

        ans = 0

        for i in range(len(boxes)):
            ans = max(ans, self.solve(i, boxes))

        return ans

    def addBox(self, boxes, a, b, h):
        if a < b:
            a, b = b, a
        boxes.append([a, b, h])

    def solve(self, i, boxes):
        ans = boxes[i][2]

        for j in range(len(boxes)):
            if boxes[j][0] < boxes[i][0] and boxes[j][1] < boxes[i][1]:
                ans = max(ans, boxes[i][2] + self.solve(j, boxes))

        return ans

TC: O(3ⁿ)
SC: O(n)

2. Memoization (Top-Down)
class Solution:
    def maxHeight(self, height: list[int], width: list[int], length: list[int]) -> int:
        # Code here
        boxes = []
        n = len(height)

        for i in range(n):
           self.addBox(boxes, width[i], length[i], height[i])
           self.addBox(boxes, height[i], length[i], width[i])
           self.addBox(boxes, height[i], width[i], length[i])
           
        n = len(boxes)
           
        dp = [-1] * n
        ans = 0
        

        for i in range(len(boxes)):
           ans = max(ans, self.solve(i, boxes,dp))

        return ans

    def addBox(self, boxes, a, b, h):
       if a < b:
           a, b = b, a

       boxes.append([a, b, h])

    def solve(self, index, boxes,dp):
       current = boxes[index]

       max_height = current[2]
       
       if dp[index] != -1:
           return dp[index]

       for i in range(len(boxes)):
           next_box = boxes[i]

           if (next_box[0] < current[0] and
               next_box[1] < current[1]):

               height = current[2] + self.solve(i, boxes,dp)

               max_height = max(max_height, height)
       dp[index] = max_height

       return dp[index]

3. Tabulation (Bottom-Up)
class Solution:
    def maxHeight(self, height: list[int], width: list[int], length: list[int]) -> int:
        boxes = []
        n = len(height)

        for i in range(n):
            self.addBox(boxes, width[i], length[i], height[i])
            self.addBox(boxes, height[i], length[i], width[i])
            self.addBox(boxes, height[i], width[i], length[i])

        boxes.sort(reverse=True)

        n = len(boxes)
        dp = [0] * n

        for i in range(n):
            dp[i] = boxes[i][2]

        for i in range(n - 1, -1, -1):
            current = boxes[i]

            for j in range(i + 1, n):
                next_box = boxes[j]

                if (next_box[0] < current[0] and
                    next_box[1] < current[1]):

                    dp[i] = max(dp[i], current[2] + dp[j])

        return max(dp)

    def addBox(self, boxes, a, b, h):
        if a < b:
            a, b = b, a

        boxes.append([a, b, h])

TC: O(n² log n)
SC: O(n)
