## 1. Recursion

```python
class Solution:
    def solve(self, arr, i, prev):
        if i == len(arr):
            return 0

        keep = abs(prev - arr[i]) + self.solve(arr, i + 1, arr[i])
        replace = abs(prev - 1) + self.solve(arr, i + 1, 1)

        return max(keep, replace)

    def maxDiffSum(self, arr):
        if len(arr) == 1:
            return 0

        keep = self.solve(arr, 1, arr[0])
        replace = self.solve(arr, 1, 1)

        return max(keep, replace)
```

**TC:** `O(2^n)`
**SC:** `O(n)`

## 2. Memoization (Top-Down)

```python
class Solution:
    def solve(self, arr, i, prev, dp):
        if i == len(arr):
            return 0

        if dp[i][prev] != -1:
            return dp[i][prev]

        previous = arr[i - 1] if prev == 0 else 1

        keep = abs(previous - arr[i]) + self.solve(arr, i + 1, 0, dp)
        replace = abs(previous - 1) + self.solve(arr, i + 1, 1, dp)

        dp[i][prev] = max(keep, replace)

        return dp[i][prev]

    def maxDiffSum(self, arr):
        n = len(arr)

        if n == 1:
            return 0

        dp = [[-1] * 2 for _ in range(n)]

        keep = self.solve(arr, 1, 0, dp)
        replace = self.solve(arr, 1, 1, dp)

        return max(keep, replace)
```

**TC:** `O(n)`
**SC:** `O(n)`

## 3. Tabulation (Bottom-Up)

```python
class Solution:
    def maxDiffSum(self, arr):
        n = len(arr)

        if n == 1:
            return 0

        dp = [[0] * 2 for _ in range(n)]

        for i in range(n - 2, -1, -1):
            for prev in range(2):
                previous = arr[i] if prev == 0 else 1

                keep = abs(previous - arr[i + 1]) + dp[i + 1][0]
                replace = abs(previous - 1) + dp[i + 1][1]

                dp[i][prev] = max(keep, replace)

        return max(dp[0][0], dp[0][1])
```

**TC:** `O(n)`
**SC:** `O(n)`

## 4. Space Optimization

```python
class Solution:
   

  
    def maxDiffSum(self, arr):
        # code here
        n = len(arr)
        if n == 1:
            return 0
        pr = [0] * 2 
        
        for i in range(n - 2, -1, -1):
            cr = [0] * 2 
            
            for p in range(2):
                prev = arr[i] if p == 0 else 1
    
                keep = abs(prev - arr[i+1]) + pr[0]
                replace = abs(prev - 1) + pr[1]
            
                cr[p] = max(keep, replace)
            pr = cr
        return max(pr[0], pr[1])
```

**TC:** `O(n)`
**SC:** `O(1)`
