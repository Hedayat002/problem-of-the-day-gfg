class Solution:
    def maxProduct(self, arr: list[int], k: int) -> int:

        max_product, min_product = self.solve(arr, 0, k)

        return max_product

    def solve(self, arr, index, k):

        # Exactly k elements selected
        if k == 0:
            return 1, 1

        # Not enough elements remaining
        if len(arr) - index < k:
            return float('-inf'), float('inf')

        # Pick current element
        take_max, take_min = self.solve(
            arr,
            index + 1,
            k - 1
        )

        take1 = arr[index] * take_max
        take2 = arr[index] * take_min

        current_take_max = max(take1, take2)
        current_take_min = min(take1, take2)

        # Don't pick current element
        skip_max, skip_min = self.solve(
            arr,
            index + 1,
            k
        )


        # Combine both possibilities
        maximum = max(current_take_max, skip_max)
        minimum = min(current_take_min, skip_min)

        return maximum, minimum

