class Solution:
    def maxProduct(self, arr: list[int], k: int) -> int:
        # code here
           n = len(arr)
        
           arr.sort()
        
           product = 1
        
           # If k is odd and largest element is 0
           # 0 is the maximum possible product
           if arr[n - 1] == 0 and (k & 1) == 1:
               return 0
        
           # If all elements are negative/zero and k is odd
           # choose k largest elements
           if arr[n - 1] <= 0 and (k & 1) == 1:
               for i in range(n - 1, n - k - 1, -1):
                   product *= arr[i]
               return product
        
           left = 0
           right = n - 1
        
           # If k is odd, take the largest element first
           if (k & 1) == 1:
               product *= arr[right]
               right -= 1
               k -= 1
        
           # Now k is even
           # Select k/2 pairs
           k //= 2
        
           for _ in range(k):
               leftProd = arr[left] * arr[left + 1]
               rightProd = arr[right] * arr[right - 1]
        
               if leftProd > rightProd:
                   product *= leftProd
                   left += 2
               else:
                   product *= rightProd
                   right -= 2
        
           return product
Time Complexity: O(n log n) due to sorting.
Extra Space: O(1) auxiliary space (ignoring Python's sorting implementation).
