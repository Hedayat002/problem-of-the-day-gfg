## Brute Force

```python
class Solution:
    def isNegativeWeightCycle(self, V: int, edges: list[list[int]]) -> bool:
        from itertools import permutations

        graph = [[] for _ in range(V)]

        for u, v, w in edges:
            graph[u].append((v, w))

        for start in range(V):
            for length in range(1, V + 1):
                for path in permutations(
                    [x for x in range(V) if x != start],
                    length - 1
                ):
                    cycle = (start,) + path

                    total = 0
                    valid = True

                    for i in range(len(cycle)):
                        u = cycle[i]
                        v = cycle[(i + 1) % len(cycle)]

                        found = False
                        for to, w in graph[u]:
                            if to == v:
                                total += w
                                found = True
                                break

                        if not found:
                            valid = False
                            break

                    if valid and total < 0:
                        return True

        return False
```

**TC:** `O(V!)`
**SC:** `O(V + E)`

