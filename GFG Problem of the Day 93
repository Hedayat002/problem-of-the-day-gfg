class Solution:
    def dfs(self, node, dst, graph, visited, cost, ans):
        if cost >= ans[0]:
            return

        if node == dst:
            ans[0] = cost
            return

        visited[node] = True

        for nxt, reverse_cost in graph[node]:
            if not visited[nxt]:
                self.dfs(
                    nxt,
                    dst,
                    graph,
                    visited,
                    cost + reverse_cost,
                    ans
                )

        visited[node] = False

    def minEdgeReversals(self, n, edges, src, dst):
        graph = [[] for _ in range(n + 1)]

        for u, v in edges:
            graph[u].append((v, 0))
            graph[v].append((u, 1))

        visited = [False] * (n + 1)
        ans = [float('inf')]

        self.dfs(src, dst, graph, visited, 0, ans)

        return -1 if ans[0] == float('inf') else ans[0]
TC: Worst-case exponential because this DFS explores paths.
SC: O(n + m) for the graph, plus O(n) recursion/visited space

