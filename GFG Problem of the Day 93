Dijkstra's Approach:
import heapq

class Solution:
    def minEdgeReversals(self, n, edges, src, dst):
        graph = [[] for _ in range(n + 1)]

        for u, v in edges:
            graph[u].append((v, 0))
            graph[v].append((u, 1))

        dist = [float('inf')] * (n + 1)
        dist[src] = 0

        pq = [(0, src)]

        while pq:
            cost, u = heapq.heappop(pq)

            if cost != dist[u]:
                continue

            if u == dst:
                return cost

            for v, weight in graph[u]:
                new_cost = cost + weight

                if new_cost < dist[v]:
                    dist[v] = new_cost
                    heapq.heappush(pq, (new_cost, v))

        return -1


TC: O((n + m) log n)
SC: O(n + m)

