from collections import deque

class Solution:
    def minEdgeReversals(self, n, edges, src, dst):
        graph = [[] for _ in range(n + 1)]

        for u, v in edges:
            graph[u].append((v, 0))
            graph[v].append((u, 1))

        dist = [float('inf')] * (n + 1)
        dist[src] = 0

        dq = deque([src])

        while dq:
            u = dq.popleft()

            for v, cost in graph[u]:
                new_cost = dist[u] + cost

                if new_cost < dist[v]:
                    dist[v] = new_cost

                    if cost == 0:
                        dq.appendleft(v)
                    else:
                        dq.append(v)

        return -1 if dist[dst] == float('inf') else dist[dst]
TC: O(n + m)
SC: O(n + m)
