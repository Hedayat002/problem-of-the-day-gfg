## 3. Optimized Solution — Two Stacks + Simultaneous Inorder Traversal

```python
class Solution:
    def findCommon(self, r1: 'Node', r2: 'Node') -> list[int]:

        stack1 = []
        stack2 = []
        result = []

        curr1 = r1
        curr2 = r2

        while (curr1 or stack1) and (curr2 or stack2):

            # Push all left nodes of BST 1
            while curr1:
                stack1.append(curr1)
                curr1 = curr1.left

            # Push all left nodes of BST 2
            while curr2:
                stack2.append(curr2)
                curr2 = curr2.left

            # Compare smallest available nodes
            if stack1[-1].data == stack2[-1].data:
                value = stack1[-1].data
                result.append(value)

                curr1 = stack1.pop().right
                curr2 = stack2.pop().right

            elif stack1[-1].data < stack2[-1].data:
                curr1 = stack1.pop().right

            else:
                curr2 = stack2.pop().right

        return result
```

**Time Complexity:** O(n1 + n2)  
**Auxiliary Space Complexity:** O(h1 + h2)

