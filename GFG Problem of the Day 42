# Brute Force Code

```python
import heapq

class Solution:
    def shortestPath(self, V: int, src: int, dest: int, edges):

        # Build Graph
        adj = [[] for _ in range(V)]

        for u, v, wt in edges:
            adj[u].append((v, wt))
            adj[v].append((u, wt))

        # Distance array
        distance = [float("inf")] * V
        distance[src] = 0

        # Min Heap
        pq = [(0, src)]

        while pq:

            currDist, node = heapq.heappop(pq)

            # Ignore outdated entry
            if currDist != distance[node]:
                continue

            if node == dest:
                return currDist

            for adjNode, weight in adj[node]:

                newDist = currDist + weight

                if newDist < distance[adjNode]:

                    distance[adjNode] = newDist
                    heapq.heappush(pq, (newDist, adjNode))

        return -1
```

