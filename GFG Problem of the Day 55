## 2. Memoization (Top-Down)

```python
class Solution:
    def solve(self, i, prevTask, h, l, dp):
        if i < 0:
            return 0

        if dp[i][prevTask] != -1:
            return dp[i][prevTask]

        skip = self.solve(i - 1, False, h, l, dp)

        low = l[i] + self.solve(i - 1, True, h, l, dp)

        high = 0
        if not prevTask:
            high = h[i] + self.solve(i - 1, True, h, l, dp)

        dp[i][prevTask] = max(skip, low, high)
        return dp[i][prevTask]

    def maxTask(self, h: list[int], l: list[int]) -> int:
        n = len(h)
        dp = [[-1] * 2 for _ in range(n)]

        return self.solve(n - 1, False, h, l, dp)
```

**TC:** O(n)  
**SC:** O(n)

