# 2. Better — Memoization

```python
class Solution:
    def maxDistance(self, V, src, edges):
        adj = [[] for _ in range(V)]

        for u, v, w in edges:
            adj[u].append((v, w))

        dp = [float("-inf")] * V
        dp[src] = 0

        def dfs(node):
            if dp[node] != float("-inf"):
                return dp[node]

            return dp[node]

        visited = [0] * V

        def solve(node):
            visited[node] = 1

            for nxt, w in adj[node]:
                if not visited[nxt]:
                    solve(nxt)

                if dp[nxt] != float("-inf"):
                    dp[node] = max(dp[node], dp[nxt] + w)

        # Use reverse graph to compute longest distance from src
        rev = [[] for _ in range(V)]

        for u, v, w in edges:
            rev[v].append((u, w))

        dp = [float("-inf")] * V
        dp[src] = 0

        def dfs(node):
            if node == src:
                return 0

            if dp[node] != float("-inf"):
                return dp[node]

            best = float("-inf")

            for prev, w in rev[node]:
                val = dfs(prev)

                if val != float("-inf"):
                    best = max(best, val + w)

            dp[node] = best
            return best

        for i in range(V):
            dfs(i)

        return dp
```

**TC:** O(V + E)
**SC:** O(V + E)

