# 3. Optimal — Topological Sort + Relaxation

```python
class Solution:
    def maxDistance(self, V, src, edges):
        adj = [[] for _ in range(V)]

        for u, v, w in edges:
            adj[u].append((v, w))

        def dfs(node):
            visited[node] = 1

            for nxt, _ in adj[node]:
                if not visited[nxt]:
                    dfs(nxt)

            stack.append(node)

        visited = [0] * V
        stack = []

        for i in range(V):
            if not visited[i]:
                dfs(i)

        distance = [float("-inf")] * V
        distance[src] = 0

        while stack:
            node = stack.pop()

            if distance[node] == float("-inf"):
                continue

            for nxt, w in adj[node]:
                distance[nxt] = max(
                    distance[nxt],
                    distance[node] + w
                )

        return distance
```

**TC:** O(V + E)
**SC:** O(V + E)

