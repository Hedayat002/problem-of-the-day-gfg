class Solution:
    MOD = 1000000007
    def palindromicStrings(self, n, k):
        # code here
        # length 1
        ans = k
        ways = 1

        for m in range(1, n // 2 + 1):
            ways = ways * (k - m + 1) % self.MOD
            evenWays = ways

            ans = (ans + evenWays) % self.MOD

            if 2 * m + 1 <= n:
                oddWays = ways * (k - m) % self.MOD
                ans = (ans + oddWays) % self.MOD

        return ans
TC: O(n)
SC: O(1)
