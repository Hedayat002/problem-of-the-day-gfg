# Problem: Minimum Sum Subarray

# Approach 1: Naive Approach (Try All Subarrays)
# T.C: O(n^2)
# S.C: O(1)

class Solution:
    def minSubarraySum(self, arr: list[int]) -> int:
        n = len(arr)
        ans = float('inf')

        for i in range(n):
            temp = 0
            for j in range(i, n):
                temp += arr[j]
                ans = min(ans, temp)

        return ans


# Approach 2: Optimal Approach (Kadane's Algorithm)
# T.C: O(n)
# S.C: O(1)

class Solution:
    def minSubarraySum(self, arr: list[int]) -> int:
        curMin = float('inf')
        ans = float('inf')

        for num in arr:
            if curMin > 0:
                curMin = num
            else:
                curMin += num

            ans = min(ans, curMin)

        return ans

