class Solution:
    def formPyramid(self, arr):
        # code here 
            n = len(arr)

            left = [0] * n
            right = [0] * n

            left[0] = 1

            for i in range(1, n):
                left[i] = min(arr[i], left[i - 1] + 1)

            right[n - 1] = 1

            for i in range(n - 2, -1, -1):
                right[i] = min(arr[i], right[i + 1] + 1)

            total_sum = 0
            max_sum = 0

            for i in range(n):
                total_sum += arr[i]

                peak = min(left[i], right[i])

                pyramid_sum = peak * peak

                max_sum = max(max_sum, pyramid_sum)

            return total_sum - max_sum
Time  = O(n)
Space = O(n)
