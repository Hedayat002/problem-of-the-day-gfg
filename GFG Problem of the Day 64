### Brute Force

```python
class Solution:
    def countTriplets(self, arr: list[int], l: int, r: int) -> int:
        n = len(arr)
        cnt = 0

        for i in range(n - 2):
            for j in range(i + 1, n - 1):
                for k in range(j + 1, n):
                    total = arr[i] + arr[j] + arr[k]

                    if l <= total <= r:
                        cnt += 1

        return cnt
```

**TC:** `O(n³)`
**SC:** `O(1)`

### Better

```python
class Solution:
    def countTriplets(self, arr: list[int], l: int, r: int) -> int:
        arr.sort()
        n = len(arr)
        cnt = 0

        for i in range(n - 2):
            left = i + 1
            right = n - 1

            while left < right:
                total = arr[i] + arr[left] + arr[right]

                if l <= total <= r:
                    cnt += 1
                    left += 1
                elif total < l:
                    left += 1
                else:
                    right -= 1

        return cnt
```

**TC:** `O(n²)`
**SC:** `O(1)`

### Optimal

```python
class Solution:
    def countTriplets(self, arr: list[int], l: int, r: int) -> int:
        arr.sort()
        n = len(arr)

        cnt_r = 0
        cnt_l = 0

        for i in range(n - 2):
            left = i + 1
            right = n - 1

            while left < right:
                total = arr[i] + arr[left] + arr[right]

                if total <= r:
                    cnt_r += right - left
                    left += 1
                else:
                    right -= 1

        for i in range(n - 2):
            left = i + 1
            right = n - 1

            while left < right:
                total = arr[i] + arr[left] + arr[right]

                if total <= l - 1:
                    cnt_l += right - left
                    left += 1
                else:
                    right -= 1

        return cnt_r - cnt_l
```

**TC:** `O(n²)`
**SC:** `O(1)`

### Algorithm / Flowchart

```text
Start
  ↓
Sort array
  ↓
Count triplets with sum ≤ r
  ↓
Two pointers
  ↓
total ≤ r ?
 ├── Yes → cnt += right-left → left++
 └── No  → right--
  ↓
Count triplets with sum ≤ l-1
  ↓
Two pointers
  ↓
Answer = count(≤r) - count(≤l-1)
  ↓
End
```
