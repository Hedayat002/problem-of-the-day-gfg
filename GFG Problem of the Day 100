## 2. Memoization (Top-Down)

```python
class Solution:
    def solve(self, i, prev, discs, n, dp):
        if i == n:
            return 0

        if dp[i][prev + 1] != -1:
            return dp[i][prev + 1]

        not_take = self.solve(i + 1, prev, discs, n, dp)

        take = 0
        if prev == -1 or (
            discs[i][0] > discs[prev][0]
            and discs[i][1] > discs[prev][1]
        ):
            take = discs[i][1] + self.solve(i + 1, i, discs, n, dp)

        dp[i][prev + 1] = max(take, not_take)
        return dp[i][prev + 1]

    def maxStackHeight(self, r, h):
        discs = sorted(zip(r, h))
        n = len(discs)
        dp = [[-1] * (n + 1) for _ in range(n)]

        return self.solve(0, -1, discs, n, dp)
```

**TC:** O(n²)
**SC:** O(n²)

