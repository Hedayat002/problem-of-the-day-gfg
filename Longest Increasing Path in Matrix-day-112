1. Recursion

class Solution:
    def solve(self,i, j, matrix, n, m):
        # Check longest increasing path
        # for each cell.

        ans = 1

        # Up
        if i - 1 >= 0 and matrix[i - 1][j] > matrix[i][j]:
            ans = max(ans, 1 + self.solve(i - 1, j, matrix, n, m))

        # Down
        if i + 1 < n and matrix[i + 1][j] > matrix[i][j]:
            ans = max(ans, 1 + self.solve(i + 1, j, matrix, n, m))

        # Left
        if j - 1 >= 0 and matrix[i][j - 1] > matrix[i][j]:
            ans = max(ans, 1 + self.solve(i, j - 1, matrix, n, m))

        # Right
        if j + 1 < m and matrix[i][j + 1] > matrix[i][j]:
            ans = max(ans, 1 + self.solve(i, j + 1, matrix, n, m))

        return ans
    def longIncPath(self, matrix, n, m):
        # code here
        n = len(matrix)
        m = len(matrix[0])

        ans = 0

        # Check every cell as a starting point
        for i in range(n):
            for j in range(m):
                ans = max(ans, self.solve(i, j, matrix, n, m))
                
        return ans

TC: O(4^(n*m))
SC: O(n*m) recursion stack

2. Memoization (Top-Down)
class Solution:
    def solve(self,i, j, matrix, n, m,dp):
        # Check longest increasing path
        # for each cell.

        ans = 1
        if dp[i][j] != -1:
            return dp[i][j]

        # Up
        if i - 1 >= 0 and matrix[i - 1][j] > matrix[i][j]:
            ans = max(ans, 1 + self.solve(i - 1, j, matrix, n, m,dp))

        # Down
        if i + 1 < n and matrix[i + 1][j] > matrix[i][j]:
            ans = max(ans, 1 + self.solve(i + 1, j, matrix, n, m,dp))

        # Left
        if j - 1 >= 0 and matrix[i][j - 1] > matrix[i][j]:
            ans = max(ans, 1 + self.solve(i, j - 1, matrix, n, m,dp))

        # Right
        if j + 1 < m and matrix[i][j + 1] > matrix[i][j]:
            ans = max(ans, 1 + self.solve(i, j + 1, matrix, n, m,dp))
        
        dp[i][j] = ans
        return dp[i][j]
    def longIncPath(self, matrix, n, m):
        # code here
        n = len(matrix)
        m = len(matrix[0])

        ans = 0
        dp = [[-1] * m for _ in range(n)]

        # Check every cell as a starting point
        for i in range(n):
            for j in range(m):
                ans = max(ans, self.solve(i, j, matrix, n, m,dp))
                
        return ans
TC: O(n*m)
SC: O(n*m)

3. Tabulation (Bottom-Up)
class Solution:
    def longIncPath(self, matrix, n, m):
        n = len(matrix)
        m = len(matrix[0])

        dp = [[1] * m for _ in range(n)]
        indegree = [[0] * m for _ in range(n)]

        for i in range(n):
            for j in range(m):
                if i - 1 >= 0 and matrix[i - 1][j] < matrix[i][j]:
                    indegree[i][j] += 1

                if i + 1 < n and matrix[i + 1][j] < matrix[i][j]:
                    indegree[i][j] += 1

                if j - 1 >= 0 and matrix[i][j - 1] < matrix[i][j]:
                    indegree[i][j] += 1

                if j + 1 < m and matrix[i][j + 1] < matrix[i][j]:
                    indegree[i][j] += 1

        queue = []

        for i in range(n):
            for j in range(m):
                if indegree[i][j] == 0:
                    queue.append((i, j))

        ans = 1

        while queue:
            i, j = queue.pop(0)

            if i - 1 >= 0 and matrix[i - 1][j] > matrix[i][j]:
                dp[i - 1][j] = max(dp[i - 1][j], dp[i][j] + 1)
                indegree[i - 1][j] -= 1

                if indegree[i - 1][j] == 0:
                    queue.append((i - 1, j))

            if i + 1 < n and matrix[i + 1][j] > matrix[i][j]:
                dp[i + 1][j] = max(dp[i + 1][j], dp[i][j] + 1)
                indegree[i + 1][j] -= 1

                if indegree[i + 1][j] == 0:
                    queue.append((i + 1, j))

            if j - 1 >= 0 and matrix[i][j - 1] > matrix[i][j]:
                dp[i][j - 1] = max(dp[i][j - 1], dp[i][j] + 1)
                indegree[i][j - 1] -= 1

                if indegree[i][j - 1] == 0:
                    queue.append((i, j - 1))

            if j + 1 < m and matrix[i][j + 1] > matrix[i][j]:
                dp[i][j + 1] = max(dp[i][j + 1], dp[i][j] + 1)
                indegree[i][j + 1] -= 1

                if indegree[i][j + 1] == 0:
                    queue.append((i, j + 1))

            ans = max(ans, dp[i][j])

        return ans
TC: O(n*m)
SC: O(n*m)
