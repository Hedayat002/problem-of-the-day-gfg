## 4. Space Optimization

```python
class Solution:
    def findWays(self, grid):
        n = len(grid)
        MOD = 10**9 + 7

        prev_paths = [0] * n
        prev_adventure = [0] * n

        for i in range(n - 1, -1, -1):
            curr_paths = [0] * n
            curr_adventure = [0] * n

            for j in range(n - 1, -1, -1):

                if i == n - 1 and j == n - 1:
                    curr_paths[j] = 1
                    curr_adventure[j] = grid[i][j]
                    continue

                right_paths = 0
                right_adventure = 0

                if j + 1 < n:
                    right_paths = curr_paths[j + 1]
                    right_adventure = curr_adventure[j + 1]

                down_paths = prev_paths[j]
                down_adventure = prev_adventure[j]

                if grid[i][j] == 1:
                    if right_paths > 0:
                        curr_paths[j] = right_paths
                        curr_adventure[j] = (
                            grid[i][j] + right_adventure
                        )

                elif grid[i][j] == 2:
                    if down_paths > 0:
                        curr_paths[j] = down_paths
                        curr_adventure[j] = (
                            grid[i][j] + down_adventure
                        )

                else:
                    curr_paths[j] = (
                        right_paths + down_paths
                    ) % MOD

                    if curr_paths[j] > 0:
                        curr_adventure[j] = (
                            grid[i][j]
                            + max(right_adventure, down_adventure)
                        )

            prev_paths = curr_paths
            prev_adventure = curr_adventure

        return [prev_paths[0], prev_adventure[0]]
```

**TC:** O(n²)  
**SC:** O(n)
