## 2. Memoization (Top-Down)

```python
class Solution:
    def solve(self, i, j, grid, n, dp):
        if i >= n or j >= n:
            return (0, 0)

        if i == n - 1 and j == n - 1:
            return (1, grid[i][j])

        if dp[i][j] != (-1, -1):
            return dp[i][j]

        if grid[i][j] == 1:
            paths, adventure = self.solve(i, j + 1, grid, n, dp)

        elif grid[i][j] == 2:
            paths, adventure = self.solve(i + 1, j, grid, n, dp)

        else:
            right_paths, right_adventure = self.solve(
                i, j + 1, grid, n, dp
            )
            down_paths, down_adventure = self.solve(
                i + 1, j, grid, n, dp
            )

            paths = right_paths + down_paths
            adventure = max(right_adventure, down_adventure)

        if paths == 0:
            dp[i][j] = (0, 0)
        else:
            dp[i][j] = (paths, adventure + grid[i][j])

        return dp[i][j]

    def findWays(self, grid):
        n = len(grid)
        dp = [[(-1, -1) for _ in range(n)] for _ in range(n)]

        paths, max_adventure = self.solve(0, 0, grid, n, dp)

        return [paths % (10**9 + 7), max_adventure]
```

**TC:** O(n²)  
**SC:** O(n²)

