## 3. Tabulation (Bottom-Up)

```python
class Solution:
    def findWays(self, grid):
        n = len(grid)
        MOD = 10**9 + 7

        paths = [[0] * n for _ in range(n)]
        adventure = [[0] * n for _ in range(n)]

        paths[n - 1][n - 1] = 1
        adventure[n - 1][n - 1] = grid[n - 1][n - 1]

        for i in range(n - 1, -1, -1):
            for j in range(n - 1, -1, -1):

                if i == n - 1 and j == n - 1:
                    continue

                if grid[i][j] == 1:
                    if j + 1 < n and paths[i][j + 1] > 0:
                        paths[i][j] = paths[i][j + 1]
                        adventure[i][j] = (
                            grid[i][j] + adventure[i][j + 1]
                        )

                elif grid[i][j] == 2:
                    if i + 1 < n and paths[i + 1][j] > 0:
                        paths[i][j] = paths[i + 1][j]
                        adventure[i][j] = (
                            grid[i][j] + adventure[i + 1][j]
                        )

                else:
                    if j + 1 < n:
                        paths[i][j] += paths[i][j + 1]
                        adventure[i][j] = max(
                            adventure[i][j],
                            adventure[i][j + 1]
                        )

                    if i + 1 < n:
                        paths[i][j] += paths[i + 1][j]
                        adventure[i][j] = max(
                            adventure[i][j],
                            adventure[i + 1][j]
                        )

                    if paths[i][j] > 0:
                        adventure[i][j] += grid[i][j]

                    paths[i][j] %= MOD

        return [paths[0][0], adventure[0][0]]
```

**TC:** O(n²)  
**SC:** O(n²)

