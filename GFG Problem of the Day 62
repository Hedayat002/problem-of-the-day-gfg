class Solution:
    def minThrows(self, n, lad, sn):
        # code here
        total = n * n

        jump = [0] * (total + 1)

        for i in range(0, len(lad), 2):
            jump[lad[i]] = lad[i + 1]

        for i in range(0, len(sn), 2):
            jump[sn[i]] = sn[i + 1]

        visited = [False] * (total + 1)
        q = deque()

        q.append((1, 0))
        visited[1] = True

        while q:
            cell, throw_count = q.popleft()

            if cell == total:
                return throw_count

            for dice in range(1, 7):
                next_cell = cell + dice

                if next_cell > total:
                    continue

                if jump[next_cell] != 0:
                    next_cell = jump[next_cell]

                if not visited[next_cell]:
                    visited[next_cell] = True
                    q.append((next_cell, throw_count + 1))

        return -1
