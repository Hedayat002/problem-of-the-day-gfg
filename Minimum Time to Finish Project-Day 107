### 1. DFS — Memoization

```python
class Solution:
    def dfs(self, u, adj, duration, dp, state):
        if state[u] == 1:
            return -1
        if dp[u] != -1:
            return dp[u]

        state[u] = 1
        longest = 0

        for v in adj[u]:
            t = self.dfs(v, adj, duration, dp, state)
            if t == -1:
                return -1
            longest = max(longest, t)

        state[u] = 2
        dp[u] = duration[u] + longest
        return dp[u]

    def minTime(self, duration, dependencies):
        n = len(duration)
        adj = [[] for _ in range(n)]

        for u, v in dependencies:
            adj[u].append(v)

        dp = [-1] * n
        state = [0] * n
        ans = 0

        for i in range(n):
            t = self.dfs(i, adj, duration, dp, state)
            if t == -1:
                return -1
            ans = max(ans, t)

        return ans
```

**TC:** `O(n + m)`
**SC:** `O(n + m)` → adjacency list + recursion/memoization

