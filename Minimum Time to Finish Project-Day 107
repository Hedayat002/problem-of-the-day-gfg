### 3. Topological Sort using DFS

```python
class Solution:
    
    def dfs(self, u, adj, duration, state, topo):
        # Cycle detected
        if state[u] == 1:
            return False
        
        # Already visited
        if state[u] == 2:
            return True
        
        state[u] = 1
        
        for v in adj[u]:
            if not self.dfs(v, adj, duration, state, topo):
                return False
        
        state[u] = 2
        topo.append(u)
        
        return True

    def minTime(self, duration, dependencies):
        n = len(duration)
        
        adj = [[] for _ in range(n)]
        
        for u, v in dependencies:
            adj[u].append(v)
        
        state = [0] * n
        topo = []
        
        # Create topological ordering
        for i in range(n):
            if state[i] == 0:
                if not self.dfs(i, adj, duration, state, topo):
                    return -1
        
        # DFS gives reverse topological order
        topo.reverse()
        
        earliest = [0] * n
        ans = 0
        
        for u in topo:
            
            if earliest[u] == 0:
                earliest[u] = duration[u]
            
            ans = max(ans, earliest[u])
            
            for v in adj[u]:
                earliest[v] = max(
                    earliest[v],
                    earliest[u] + duration[v]
                )
        
        return ans
```

**TC:** `O(n + m)`
**SC:** `O(n + m)` → adjacency list + DFS stack + topological order
